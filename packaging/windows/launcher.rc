#include <winver.h>
1 ICON "vs-gammon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION  VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "VS Gammon"
      VALUE "ProductName", "VS Gammon"
      VALUE "ProductVersion", VER_TEXT
      VALUE "FileVersion", VER_TEXT
      VALUE "OriginalFilename", "VS Gammon.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
